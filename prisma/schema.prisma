generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model badge {
  id          String      @id @default(uuid())
  name        String      @unique(map: "Badge_name_key")
  code        String      @unique(map: "Badge_code_key")
  description String      @db.Text
  iconUrl     String      @default("")
  category    String
  requirement String      @db.Text
  xpReward    Int         @default(25)
  userbadge   userbadge[]
}

model calendarevent {
  id          String   @id @default(uuid())
  userId      String
  taskId      String?
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  recurrence  String   @default("none")
  color       String   @default("#4F46E5")
  reminder    String   @default("none")
  createdAt   DateTime @default(now())
  task        task?    @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "CalendarEvent_taskId_fkey")
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CalendarEvent_userId_fkey")

  @@index([endDate], map: "CalendarEvent_endDate_idx")
  @@index([startDate], map: "CalendarEvent_startDate_idx")
  @@index([taskId], map: "CalendarEvent_taskId_fkey")
  @@index([userId], map: "CalendarEvent_userId_idx")
}

model pomodorosession {
  id            String    @id @default(uuid())
  userId        String
  taskId        String?
  focusDuration Int       @default(25)
  breakDuration Int       @default(5)
  status        String    @default("running")
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  xpEarned      Int       @default(0)
  task          task?     @relation(fields: [taskId], references: [id], map: "PomodoroSession_taskId_fkey")
  user          user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PomodoroSession_userId_fkey")

  @@index([status], map: "PomodoroSession_status_idx")
  @@index([taskId], map: "PomodoroSession_taskId_fkey")
  @@index([userId], map: "PomodoroSession_userId_idx")
}

model qrsession {
  id        String   @id @default(uuid())
  userId    String?
  token     String   @unique(map: "QRSession_token_key")
  status    String   @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "QRSession_userId_fkey")

  @@index([status], map: "QRSession_status_idx")
  @@index([token], map: "QRSession_token_idx")
  @@index([userId], map: "QRSession_userId_fkey")
}

model task {
  id              String            @id @default(uuid())
  userId          String
  title           String
  description     String?           @db.Text
  priority        String            @default("medium")
  status          String            @default("todo")
  category        String?
  dueDate         DateTime?
  completedAt     DateTime?
  isDaily         Boolean           @default(false)
  isWeekly        Boolean           @default(false)
  xpReward        Int               @default(10)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  calendarevent   calendarevent[]
  pomodorosession pomodorosession[]
  user            user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Task_userId_fkey")

  @@index([dueDate], map: "Task_dueDate_idx")
  @@index([priority], map: "Task_priority_idx")
  @@index([status], map: "Task_status_idx")
  @@index([userId], map: "Task_userId_idx")
}

model transaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Float
  category        String
  coaType         String   @default("EXPENSE") // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description     String?  @db.Text
  paymentMethod   String   @default("cash")
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Transaction_userId_fkey")

  @@index([category], map: "Transaction_category_idx")
  @@index([transactionDate], map: "Transaction_transactionDate_idx")
  @@index([type], map: "Transaction_type_idx")
  @@index([userId], map: "Transaction_userId_idx")
}

model user {
  id              String            @id @default(uuid())
  email           String            @unique(map: "User_email_key")
  username        String            @unique(map: "User_username_key")
  passwordHash    String
  fullName        String
  avatarUrl       String?
  role            String            @default("USER")
  level           Int               @default(1)
  totalXP         Int               @default(0)
  loginStreak     Int               @default(0)
  lastLoginAt     DateTime?
  companyName     String?
  companyAddress  String?           @db.Text
  companyLogoUrl  String?
  resetPasswordToken String?        @unique(map: "User_resetPasswordToken_key")
  resetPasswordExpires DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  calendarevent   calendarevent[]
  pomodorosession pomodorosession[]
  qrsession       qrsession[]
  task            task[]
  transaction     transaction[]
  notification    notification[]
  userbadge       userbadge[]
  xphistory       xphistory[]
}

model userbadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade, map: "UserBadge_badgeId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserBadge_userId_fkey")

  @@unique([userId, badgeId], map: "UserBadge_userId_badgeId_key")
  @@index([badgeId], map: "UserBadge_badgeId_fkey")
  @@index([userId], map: "UserBadge_userId_idx")
}

model xphistory {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  source      String
  sourceId    String?
  description String   @db.Text
  earnedAt    DateTime @default(now())
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "XPHistory_userId_fkey")

  @@index([source], map: "XPHistory_source_idx")
  @@index([userId], map: "XPHistory_userId_idx")
}

model notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("info") // info, success, warning, alarm
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([userId], map: "Notification_userId_idx")
  @@index([isRead], map: "Notification_isRead_idx")
}
